---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { site } from '@/data/site.config';
import { getLangFromUrl, useTranslations, baseSlug } from '@/i18n/utils';
import type { UIKey } from '@/i18n/ui';

export type LegalSlug = 'offer' | 'terms' | 'refund' | 'contacts';

interface Props {
  slug: LegalSlug;
}

const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Typed per-page chrome — literal UIKeys keep uk/en key parity compile-checked.
const chrome: Record<LegalSlug, { title: UIKey; intro: UIKey; seoTitle: UIKey; seoDesc: UIKey }> = {
  offer: {
    title: 'legal.offer.title',
    intro: 'legal.offer.intro',
    seoTitle: 'seo.offer.title',
    seoDesc: 'seo.offer.desc',
  },
  terms: {
    title: 'legal.terms.title',
    intro: 'legal.terms.intro',
    seoTitle: 'seo.terms.title',
    seoDesc: 'seo.terms.desc',
  },
  refund: {
    title: 'legal.refund.title',
    intro: 'legal.refund.intro',
    seoTitle: 'seo.refund.title',
    seoDesc: 'seo.refund.desc',
  },
  contacts: {
    title: 'legal.contacts.title',
    intro: 'legal.contacts.intro',
    seoTitle: 'seo.contacts.title',
    seoDesc: 'seo.contacts.desc',
  },
};
const c = chrome[slug];

// One entry per (language, base slug); base slug is the filename (e.g. "offer").
const doc = (await getCollection('legal', ({ data }) => data.lang === lang)).find(
  (entry) => baseSlug(entry.slug) === slug,
);
if (!doc) throw new Error(`Missing legal document "${slug}" for language "${lang}"`);
const { Content } = await doc.render();

// The requisites + contact channels belong on the Contacts page only.
const showRequisites = slug === 'contacts';
const req = site.legal;
const telHref = `tel:${site.contact.phone.replace(/[^+\d]/g, '')}`;
const mailHref = `mailto:${site.contact.email}`;
---

<BaseLayout title={t(c.seoTitle)} description={t(c.seoDesc)}>
  <PageHeader eyebrow={t('legal.eyebrow')} title={t(c.title)} intro={t(c.intro)} />

  <section class="container-luxe pb-24">
    <article class="legal-prose max-w-2xl">
      <Content />
    </article>

    {
      showRequisites && (
        <div class="mt-10 max-w-2xl rounded-lg border border-white/10 bg-night-800 p-6">
          <p class="eyebrow mb-4">{t('legal.requisites.title')}</p>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-mist">{t('legal.req.name')}</dt>
              <dd class="text-cream/90">{req.entityName}</dd>
            </div>
            <div>
              <dt class="text-mist">{t('legal.req.taxId')}</dt>
              <dd class="text-cream/90">{req.taxId}</dd>
            </div>
            <div>
              <dt class="text-mist">{t('legal.req.addressLegal')}</dt>
              <dd class="text-cream/90">{req.addressLegal}</dd>
            </div>
            <div>
              <dt class="text-mist">{t('legal.req.addressActual')}</dt>
              <dd class="text-cream/90">{req.addressActual}</dd>
            </div>
            <div>
              <dt class="text-mist">{t('legal.req.phone')}</dt>
              <dd>
                <a href={telHref} class="text-cream/90 hover:text-champagne">
                  {site.contact.phone}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-mist">{t('legal.req.email')}</dt>
              <dd>
                <a href={mailHref} class="text-cream/90 hover:text-champagne">
                  {site.contact.email}
                </a>
              </dd>
            </div>
            {req.bank && (
              <div>
                <dt class="text-mist">{t('legal.req.bank')}</dt>
                <dd class="text-cream/90">{req.bank}</dd>
              </div>
            )}
          </dl>
          <SocialLinks size="md" class="mt-6" />
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .legal-prose :global(h2) {
    @apply mt-10 text-2xl;
  }
  .legal-prose :global(h3) {
    @apply mt-6 text-xl;
  }
  .legal-prose :global(p),
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    @apply mt-4 leading-relaxed text-cream/80;
  }
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    @apply list-disc space-y-2 pl-6;
  }
  .legal-prose :global(blockquote) {
    @apply mt-4 border-l-2 border-champagne/50 pl-4 italic text-mist;
  }
  .legal-prose :global(strong) {
    @apply text-cream;
  }
</style>
