---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  experience: CollectionEntry<'experiences'>;
}

const { experience } = Astro.props;
const { data } = experience;
---

<article class="overflow-hidden rounded-lg bg-night-800">
  <div class="relative aspect-[7/5] overflow-hidden">
    <Image
      src={data.image}
      alt={data.imageAlt}
      class="h-full w-full object-cover"
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
    />
  </div>
  <div class="p-6">
    <h3 class="text-2xl">{data.name}</h3>
    <p class="mt-2 text-sm text-mist">{data.description}</p>
  </div>
</article>
