---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import BookNowButton from '@/components/BookNowButton.astro';
import { site } from '@/data/site.config';

const telHref = `tel:${site.contact.phone.replace(/[^+\d]/g, '')}`;
---

<BaseLayout
  title="Location & Contact"
  description="Where to find Bubble in the mountains, how to reach us, and how to get in touch."
>
  <PageHeader
    eyebrow="Plan your visit"
    title="Finding the mountain"
    intro={site.location.description}
  />

  <section class="container-luxe grid gap-12 pb-24 lg:grid-cols-2">
    <div class="space-y-10">
      <div>
        <p class="eyebrow mb-4">Getting there</p>
        <p class="text-lg leading-relaxed text-cream/85">{site.location.directions}</p>
        {
          site.location.mapUrl && (
            <a
              href={site.location.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex min-h-11 items-center font-body text-sm uppercase tracking-luxe text-champagne underline-offset-8 hover:underline"
            >
              Open in maps ↗
            </a>
          )
        }
      </div>

      <div>
        <p class="eyebrow mb-4">Contact</p>
        <ul class="space-y-3 text-lg text-cream/85">
          <li>
            <a href={`mailto:${site.contact.email}`} class="hover:text-champagne">
              {site.contact.email}
            </a>
          </li>
          <li>
            <a href={telHref} class="hover:text-champagne">{site.contact.phone}</a>
          </li>
        </ul>
      </div>

      <BookNowButton />
    </div>

    <div class="rounded-lg bg-night-800 p-8">
      <p class="eyebrow mb-4">Good to know</p>
      <ul class="space-y-3 text-sm text-cream/80">
        <li class="border-b border-white/10 pb-3">
          A private transfer carries you the final ascent — arrange it when you book.
        </li>
        <li class="border-b border-white/10 pb-3">
          Suites are released in limited number across the season.
        </li>
        <li class="border-b border-white/10 pb-3">
          Have a question before booking? Email or call and we’ll help personally.
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
