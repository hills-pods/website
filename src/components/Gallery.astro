---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<ul class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>li]:mb-4">
  {
    items.map((item) => (
      <li class="break-inside-avoid overflow-hidden rounded-lg">
        <figure class="relative">
          <Image
            src={item.src}
            alt={item.alt}
            class="w-full"
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
          />
          {item.caption && (
            <figcaption class="bg-night-800 px-4 py-3 text-sm text-mist">{item.caption}</figcaption>
          )}
        </figure>
      </li>
    ))
  }
</ul>
