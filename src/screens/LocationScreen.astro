---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import BookNowButton from '@/components/BookNowButton.astro';
import { site } from '@/data/site.config';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const telHref = `tel:${site.contact.phone.replace(/[^+\d]/g, '')}`;

// Map widget. Both URLs override-or-derive: when `mapUrl` / `mapEmbedUrl` are set
// in site.config.ts (Google Maps in our case), we use those verbatim. When they
// are unset, both fall back to OpenStreetMap derived from `coordinates` — so
// removing the config fields reverts to a no-key, no-tracking OSM map.
const { lat, lon } = site.coordinates;
const bbox = [lon - 0.06, lat - 0.05, lon + 0.06, lat + 0.05].join(',');
const embedUrl =
  site.mapEmbedUrl ??
  `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const mapsHref = site.mapUrl ?? `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}&zoom=14`;
---

<BaseLayout title={t('seo.location.title')} description={t('seo.location.desc')}>
  <PageHeader eyebrow={t('loc.eyebrow')} title={t('loc.title')} intro={t('loc.description')} />

  <section class="container-luxe grid gap-12 pb-24 lg:grid-cols-2">
    <div class="space-y-10">
      <div>
        <p class="eyebrow mb-4">{t('loc.gettingThere')}</p>
        <p class="text-lg leading-relaxed text-cream/85">{t('loc.directions')}</p>
        <a
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex min-h-11 items-center font-body text-sm uppercase tracking-luxe text-champagne underline-offset-8 hover:underline"
        >
          {t('loc.openMaps')}
        </a>
      </div>

      <div>
        <p class="eyebrow mb-4">{t('loc.contact')}</p>
        <ul class="space-y-3 text-lg text-cream/85">
          <li>
            <a href={`mailto:${site.contact.email}`} class="hover:text-champagne">
              {site.contact.email}
            </a>
          </li>
          <li>
            <a href={telHref} class="hover:text-champagne">{site.contact.phone}</a>
          </li>
        </ul>
      </div>

      <BookNowButton />
    </div>

    <!-- Map widget. Lazy-loaded so it doesn't block the LCP element above. -->
    <div class="min-h-[420px] overflow-hidden rounded-lg border border-white/10 bg-night-800">
      <iframe
        src={embedUrl}
        title={t('loc.mapTitle')}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
        class="h-full min-h-[420px] w-full border-0"></iframe>
    </div>
  </section>
</BaseLayout>
