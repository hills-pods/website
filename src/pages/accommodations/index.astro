---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SuiteCard from '@/components/SuiteCard.astro';

const suites = (await getCollection('suites')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="The Suites"
  description="Explore the transparent bubble suites at Bubble — each a different way to sleep beneath the mountain sky."
>
  <PageHeader
    eyebrow="Accommodations"
    title="Choose your bubble"
    intro="A small collection of transparent suites, each framing the mountains differently. Every stay includes the quiet essentials of a Bubble night."
  />

  <section class="container-luxe pb-24 sm:pb-32">
    <h2 class="sr-only">Our suites</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {suites.map((suite) => <SuiteCard suite={suite} />)}
    </div>
  </section>
</BaseLayout>
