---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizeHref, baseSlug } from '@/i18n/utils';

interface Props {
  suite: CollectionEntry<'suites'>;
  /** When true, image is on the right and text on the left at desktop sizes. */
  reverse?: boolean;
}

const { suite, reverse = false } = Astro.props;
const { data } = suite;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = localizeHref(`/accommodations/${baseSlug(suite.slug)}`, lang);
---

<article
  class:list={[
    'flex flex-col items-center gap-10 lg:gap-16',
    reverse ? 'lg:flex-row-reverse' : 'lg:flex-row',
  ]}
>
  <a href={href} class="group relative block w-full overflow-hidden rounded-lg lg:w-1/3">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Image
        src={data.heroImage}
        alt={data.heroImageAlt}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        widths={[400, 600, 800, 1200]}
        sizes="(min-width: 1024px) 33vw, 100vw"
        loading="lazy"
      />
      {
        !data.available && (
          <span class="absolute left-4 top-4 rounded-full bg-night/80 px-3 py-1 font-body text-xs uppercase tracking-luxe text-champagne">
            {t('card.unavailable')}
          </span>
        )
      }
    </div>
  </a>

  <div class="w-full lg:w-2/3">
    <p class="eyebrow">{data.view}</p>
    <h2 class="mt-3 text-4xl sm:text-5xl">
      <a href={href} class="transition-colors hover:text-champagne">{data.name}</a>
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-cream/80">{data.description ?? data.summary}</p>
    <a
      href={href}
      class="mt-6 inline-flex min-h-11 items-center font-body text-sm uppercase tracking-luxe text-champagne underline-offset-8 hover:underline"
    >
      {t('card.discover')}
    </a>
  </div>
</article>
