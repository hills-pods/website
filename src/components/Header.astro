---
import { navLinks } from '@/data/nav';
import { getLangFromUrl, useTranslations, localizeHref, toCanonicalPath } from '@/i18n/utils';
import BookNowButton from './BookNowButton.astro';
import MobileNav from './MobileNav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = toCanonicalPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? canonical === '/' : canonical.startsWith(href));
---

<header data-header class="fixed inset-x-0 top-0 z-30">
  <!-- Initial scrim: a soft gradient that keeps the header readable over the hero photo
       at the very top of the page. Fades out once the user scrolls. -->
  <div
    data-header-scrim
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-48 bg-gradient-to-b from-night/85 via-night/40 to-transparent transition-opacity duration-300"
  >
  </div>
  <!-- Scrolled backdrop: translucent frosted bar that fades in once the user scrolls past
       the hero edge, so page content never bleeds through the header. -->
  <div
    data-header-backdrop
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 border-b border-white/10 bg-night/90 opacity-0 backdrop-blur-md transition-opacity duration-300"
  >
  </div>
  <div class="container-luxe flex items-center justify-between py-6">
    <a
      href={localizeHref('/', lang)}
      class="font-display text-2xl tracking-wide text-cream"
      aria-label={t('nav.home.aria')}
    >
      {t('brand.name')}
    </a>

    <nav class="hidden md:block" aria-label={t('nav.primary')}>
      <ul class="flex items-center gap-8">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={localizeHref(link.href, lang)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'font-body text-sm uppercase tracking-luxe transition-colors hover:text-champagne',
                  isActive(link.href) ? 'text-champagne' : 'text-cream',
                ]}
              >
                {t(link.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Book Now + language switcher are persistent and visible at every size (FR-005/FR-017). -->
    <div class="flex items-center gap-3">
      <LanguageSwitcher />
      <BookNowButton variant="subtle" class="px-4 py-2 text-xs sm:px-6 sm:py-3 sm:text-sm" />
      <MobileNav />
    </div>
  </div>
</header>

<script>
  // Scroll-aware header: scrim over the hero (top of page), translucent backdrop once
  // the user scrolls. Progressive enhancement — no-JS visitors keep the scrim, which is
  // already enough for header readability over a hero photo and invisible on dark pages.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const scrim = header?.querySelector<HTMLElement>('[data-header-scrim]');
  const backdrop = header?.querySelector<HTMLElement>('[data-header-backdrop]');
  if (header && scrim && backdrop) {
    const SCROLL_THRESHOLD = 40;
    const update = () => {
      const scrolled = window.scrollY > SCROLL_THRESHOLD;
      scrim.classList.toggle('opacity-0', scrolled);
      backdrop.classList.toggle('opacity-0', !scrolled);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
