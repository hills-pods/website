---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getLangFromUrl, useTranslations, localizeHref } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('seo.thanks.title')} description={t('seo.thanks.desc')}>
  <PageHeader eyebrow={t('thanks.eyebrow')} title={t('thanks.title')} intro={t('thanks.body')} />

  <section class="container-luxe pb-24">
    <a
      href={localizeHref('/', lang)}
      class="inline-flex min-h-11 items-center font-body text-sm uppercase tracking-luxe text-champagne underline-offset-8 hover:underline"
    >
      {t('thanks.backHome')}
    </a>
  </section>

  {/*
    Meta Pixel — Lead. The guest reaches this page only via the successful-
    payment return (api/payment-success → /thank-you), so a booking was
    completed; per the marketing spec that counts as a Lead. No-ops without fbq.
  */}
  <script is:inline>
    (function () {
      if (typeof window.fbq === 'function') window.fbq('track', 'Lead');
    })();
  </script>
</BaseLayout>
