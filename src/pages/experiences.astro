---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';

const experiences = (await getCollection('experiences')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Experiences"
  description="Stargazing, mountain dining, and alpine wellness — the signature experiences of a stay at Bubble."
>
  <PageHeader
    eyebrow="Experiences"
    title="The rituals of a mountain stay"
    intro="Beyond the bubble itself, a handful of carefully composed experiences turn a night into a story worth retelling."
  />

  <section class="container-luxe pb-24 sm:pb-32">
    <h2 class="sr-only">Our experiences</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {experiences.map((experience) => <ExperienceCard experience={experience} />)}
    </div>
  </section>
</BaseLayout>
