---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Gallery, { type GalleryItem } from '@/components/Gallery.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

import meadow from '@/assets/gallery/meadow.jpg';
import dusk from '@/assets/gallery/dusk.jpg';
import interior from '@/assets/gallery/interior.jpg';
import hoverla from '@/assets/suites/hoverla.jpg';
import montblanc from '@/assets/suites/mont-blanc.jpg';
import everest from '@/assets/suites/everest.jpg';
import stargazing from '@/assets/experiences/stargazing.jpg';

const t = useTranslations(getLangFromUrl(Astro.url));

const items: GalleryItem[] = [
  { src: hoverla, alt: t('gallery.alt.hoverla'), caption: t('gallery.cap.hoverla') },
  { src: meadow, alt: t('gallery.alt.meadow'), caption: t('gallery.cap.meadow') },
  { src: dusk, alt: t('gallery.alt.dusk'), caption: t('gallery.cap.dusk') },
  { src: montblanc, alt: t('gallery.alt.montblanc') },
  { src: stargazing, alt: t('gallery.alt.stargazing'), caption: t('gallery.cap.stargazing') },
  { src: interior, alt: t('gallery.alt.interior') },
  { src: everest, alt: t('gallery.alt.everest'), caption: t('gallery.cap.everest') },
];
---

<BaseLayout title={t('seo.gallery.title')} description={t('seo.gallery.desc')}>
  <PageHeader
    eyebrow={t('gallery.eyebrow')}
    title={t('gallery.title')}
    intro={t('gallery.intro')}
  />

  <section class="container-luxe pb-24 sm:pb-32">
    <Gallery items={items} />
  </section>
</BaseLayout>
