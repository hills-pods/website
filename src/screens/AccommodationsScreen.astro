---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SuiteRow from '@/components/SuiteRow.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const suites = (await getCollection('suites', ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={t('seo.suites.title')} description={t('seo.suites.desc')}>
  <PageHeader eyebrow={t('acc.eyebrow')} title={t('acc.title')} intro={t('acc.intro')} />

  <section class="container-luxe pb-24 sm:pb-32" aria-label={t('acc.srHeading')}>
    <div class="flex flex-col gap-20 sm:gap-28">
      {suites.map((suite, i) => <SuiteRow suite={suite} reverse={i % 2 === 1} />)}
    </div>
  </section>
</BaseLayout>
