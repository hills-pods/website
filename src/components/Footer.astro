---
import { site } from '@/data/site.config';
import { navLinks } from '@/data/nav';
import { getLangFromUrl, useTranslations, localizeHref } from '@/i18n/utils';
import type { UIKey } from '@/i18n/ui';
import SocialLinks from './SocialLinks.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Legal pages required by the payment gateway, linked from the footer.
const legalLinks: { href: string; key: UIKey }[] = [
  { href: '/legal', key: 'footer.offer' },
  { href: '/terms', key: 'footer.terms' },
  { href: '/refund', key: 'footer.refund' },
  { href: '/contacts', key: 'footer.contacts' },
];
---

<footer class="border-t border-white/10 bg-night-800">
  <div class="container-luxe grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="font-display text-2xl text-cream">{t('brand.name')}</p>
      <p class="mt-3 max-w-xs text-sm text-mist">{t('brand.tagline')}</p>
    </div>

    <nav aria-label={t('footer.explore')}>
      <p class="eyebrow mb-4">{t('footer.explore')}</p>
      <ul class="flex flex-col gap-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={localizeHref(link.href, lang)}
                class="text-sm text-cream/80 transition-colors hover:text-champagne"
              >
                {t(link.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="eyebrow mb-4">{t('footer.contact')}</p>
      <a
        href={`tel:${site.contact.phone.replace(/[^+\d]/g, '')}`}
        class="text-sm text-cream/80 transition-colors hover:text-champagne"
      >
        {site.contact.phone}
      </a>

      <SocialLinks class="mt-4" />
    </div>
  </div>

  <div class="container-luxe border-t border-white/5 py-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-mist">© {year} {t('brand.name')}. {t('footer.rights')}</p>
      <nav
        aria-label={t('legal.eyebrow')}
        class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-mist"
      >
        {
          legalLinks.map((link) => (
            <a
              href={localizeHref(link.href, lang)}
              class="text-cream/70 underline-offset-4 transition-colors hover:text-champagne hover:underline"
            >
              {t(link.key)}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
