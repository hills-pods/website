---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookNowButton from '@/components/BookNowButton.astro';
import { getLangFromUrl, useTranslations, baseSlug } from '@/i18n/utils';

interface Props {
  suite: CollectionEntry<'suites'>;
}

const { suite } = Astro.props;
const { data } = suite;
const t = useTranslations(getLangFromUrl(Astro.url));
const { Content } = await suite.render();

// Per-suite gallery: every photo dropped into src/assets/suites/<slug>/ is imported at
// build time and rendered below. Replace, add, or remove files in the suite's folder —
// no edits to this file or the suite's frontmatter required. Order is reshuffled per
// build (Fisher-Yates) so the gallery never reads strictly top-down.
//
// Vite requires statically analyzable globs, so we glob ALL suite folders eagerly then
// filter by slug at request time. The folder-name match handles slugs whose filenames
// don't echo the slug exactly (e.g. mont-blanc/montblanc_001.jpg).
const allSuiteImages = import.meta.glob<{ default: ImageMetadata }>('../assets/suites/*/*.jpg', {
  eager: true,
});
const slug = baseSlug(suite.slug);
const galleryImages = Object.entries(allSuiteImages)
  .filter(([path]) => path.includes(`/suites/${slug}/`))
  .map(([, mod]) => mod.default);

for (let i = galleryImages.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [galleryImages[i], galleryImages[j]] = [galleryImages[j], galleryImages[i]];
}

const frameSuffix = t('gallery.frameSuffix');
---

<BaseLayout title={data.name} description={data.summary} ogImage={data.heroImage.src}>
  <section class="relative flex min-h-[70vh] items-end overflow-hidden">
    <Image
      src={data.heroImage}
      alt={data.heroImageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-night/20"></div>
    <div class="container-luxe relative z-10 pb-16 pt-40">
      <p class="eyebrow">{data.view}</p>
      <h1 class="mt-4 text-5xl sm:text-6xl">{data.name}</h1>
      {
        !data.available && (
          <p class="mt-4 inline-block rounded-full bg-night/70 px-4 py-2 text-sm uppercase tracking-luxe text-champagne">
            {t('suite.unavailableNote')}
          </p>
        )
      }
    </div>
  </section>

  <section class="container-luxe grid gap-12 py-20 lg:grid-cols-3">
    <div class="space-y-4 text-lg leading-relaxed text-cream/85 lg:col-span-2">
      <Content />
    </div>

    <div class="space-y-10">
      <div>
        <p class="eyebrow mb-4">{t('suite.features')}</p>
        <ul class="space-y-2 text-sm text-cream/80">
          {data.features.map((f) => <li class="border-b border-white/10 pb-2">{f}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-4">{t('suite.included')}</p>
        <ul class="space-y-2 text-sm text-cream/80">
          {data.included.map((i) => <li class="border-b border-white/10 pb-2">{i}</li>)}
        </ul>
      </div>
      <BookNowButton />
    </div>
  </section>

  {
    galleryImages.length > 0 && (
      <section class="container-luxe pb-24" aria-labelledby="suite-gallery-heading">
        <h2 id="suite-gallery-heading" class="mb-8 text-3xl sm:text-4xl">
          {t('suite.gallery')}
        </h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {galleryImages.map((src, i) => (
            <li class="overflow-hidden rounded-lg">
              <Image
                src={src}
                alt={`${data.name} ${frameSuffix} ${i + 1}`}
                class="aspect-[3/4] w-full object-cover"
                widths={[400, 640, 900]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
