---
import { site } from '@/data/site.config';
import { resolveBookingTarget } from '@/lib/booking';
import { getLangFromUrl, useTranslations, localizeHref } from '@/i18n/utils';

interface Props {
  variant?: 'primary' | 'subtle';
  class?: string;
}

const { variant = 'primary', class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const target = resolveBookingTarget({
  hasEmbeddedWidget: site.easyMs !== null,
  bookingUrl: site.bookingUrl,
  contactEmail: site.contact.email,
});

const base =
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-body text-sm uppercase tracking-luxe transition-colors duration-200 min-h-11';
const styles =
  variant === 'primary'
    ? 'bg-champagne text-night hover:bg-champagne-600'
    : 'border border-champagne/60 text-champagne hover:border-champagne hover:text-cream';

// 'internal' → in-page booking screen (no new tab, no external glyph).
// 'external' → third-party provider (FR-006/007: open in new tab, mark as external).
// 'enquiry'  → mailto fallback (FR-008): never strand a guest.
const isInternal = target.kind === 'internal';
const isExternal = target.kind === 'external';
const href = isInternal ? localizeHref(target.href, lang) : target.href;
const externalAttrs = isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const label = isInternal || isExternal ? t('book.now') : t('book.enquire');
const a11yLabel = isInternal
  ? t('book.ariaInternal')
  : isExternal
    ? t('book.ariaExternal')
    : t('book.ariaEnquire');
---

<a
  href={href}
  class={`${base} ${styles} ${className}`}
  aria-label={a11yLabel}
  data-fbq="InitiateCheckout"
  {...externalAttrs}
>
  <span>{label}</span>
  {
    isExternal && (
      <span aria-hidden="true" class="text-xs">
        ↗
      </span>
    )
  }
</a>
{isExternal && <span class="sr-only">{t('book.srExternal')}</span>}
