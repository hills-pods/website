---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Gallery, { type GalleryItem } from '@/components/Gallery.astro';
import type { ImageMetadata } from 'astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));

// Every photo dropped into src/assets/gallery/ is imported at build time. Replace, add,
// or remove files in that folder and the page picks them up on the next build — no edits
// to this file required. The masonry order is reshuffled on every build (Fisher-Yates)
// so the gallery never reads strictly top-down.
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/gallery_*.jpg', {
  eager: true,
});
const images = Object.values(modules).map((m) => m.default);

for (let i = images.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [images[i], images[j]] = [images[j], images[i]];
}

const frameSuffix = t('gallery.frameSuffix');
const items: GalleryItem[] = images.map((src, i) => ({
  src,
  alt: `${t('brand.name')} ${frameSuffix} ${i + 1}`,
}));
---

<BaseLayout title={t('seo.gallery.title')} description={t('seo.gallery.desc')}>
  <PageHeader
    eyebrow={t('gallery.eyebrow')}
    title={t('gallery.title')}
    intro={t('gallery.intro')}
  />

  <section class="container-luxe pb-24 sm:pb-32">
    <Gallery items={items} />
  </section>
</BaseLayout>
